# ==============================================================================
# Plataforma de Gestão da III Sessão Bienal da Conferência Distrital da Juventude de Luanda
# Arquivo de Exemplo de Configuração de Ambiente (.env.example)
# NUNCA commitar arquivos .env ou .env.local com credenciais reais.
# ==============================================================================

# Supabase - Conexão Pública (Acessível no Browser sob proteção RLS estrita)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase - Chave de Serviço Privilegiada
# ATENÇÃO: USO EXCLUSIVO SERVER-SIDE EM SCRIPTS/ADMIN. NUNCA prefixar com NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# URL Base da Aplicação (usado para callbacks e links institucionais)
NEXT_PUBLIC_APP_URL=http://localhost:3000
